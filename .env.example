# ── Database (PostgreSQL) ─────────────────────────────
# Pooled/runtime connection (e.g. Neon pooled URL, Supabase pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/memoryletter?sslmode=require"
# Direct connection used by `prisma migrate` (omit if same as DATABASE_URL).
DIRECT_URL=""

# ── App ───────────────────────────────────────────────
# Public base URL, used to build share links and Open Graph URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth (needed from Module 2) ───────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# ── Image storage: Cloudinary (needed from Module 5) ──
# Server-only. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
